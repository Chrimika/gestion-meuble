{
  "name": "residence-st-raphael",
  "version": "1.0.0",
  "description": "Logiciel de gestion financière — Résidence St Raphaël, Yaoundé",
  "author": "Résidence St Raphaël <raphaelhome1929@gmail.com>",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"next dev -p 3421\" \"wait-on http://localhost:3421 && electron .\"",
    "electron:build:win": "node scripts/build-electron.js",
    "electron:build": "node scripts/build-electron.js",
    "electron:build:linux": "node scripts/build-electron.js linux",
    "electron:build:mac": "next build && electron-builder --mac"
  },
  "build": {
    "appId": "com.saintraphael.gestion",
    "productName": "Résidence St Raphaël",
    "copyright": "Copyright © 2026 Résidence St Raphaël",
    "icon": "public/logo.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/**/*",
      "out/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/@mapbox/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Résidence St Raphaël"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/logo.png",
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/logo.png",
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.5",
    "cross-env": "^7.0.3",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "9.1.0"
  }
}
